{
  "apiVersion": 3,
  "name": "swimlog/latest-workouts",
  "version": "1.2.0",
  "title": "Latest Workouts",
  "category": "widgets",
  "icon": "analytics",
  "description": "Display the swimmer's latest workout or recent workouts.",
  "textdomain": "chriss-swim-training-progress-evaluation",
  "attributes": {
    "user": {
      "type": "integer",
      "default": 0
    },
    "count": {
      "type": "integer",
      "default": 1
    },
    "titleMode": {
      "type": "string",
      "default": "default"
    },
    "customTitle": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "swimlog-block-latest-workouts",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  }
}
